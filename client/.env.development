# Development — requests go to the Vite dev server which proxies /api to the
# backend (see vite.config.js). Using a relative URL keeps the storefront
# working from any host (including the sandbox live preview).

# Development — requests go directly to the local backend (no Vite proxy).
VITE_API_URL=http://localhost:4000/api
VITE_STRIPE_PUBLISHABLE_KEY=

# LocationIQ API Key (Client side for road routing engine)
VITE_LOCATIONIQ_API_KEY=