# =============================================
# Kick E-Commerce - Environment Configuration
# =============================================

# Environment mode
NODE_ENV=development

# Server port
PORT=4000

# CORS origins (comma-separated)

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://192.168.0.70:5173,http://192.168.0.70:5174,http://192.168.0.70:5175,https://filtrate-chemicals-spiritual.ngrok-free.dev
# =============================================
# Database Configuration
# =============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=kick_local_password
DB_NAME=Kick
AUTO_SEED=true

# =============================================
# JWT Configuration
# IMPORTANT: Change these in production!
# Must be at least 32 characters each
# =============================================
JWT_ACCESS_SECRET=change_this_to_a_secure_32_char_access_secret
JWT_REFRESH_SECRET=change_this_to_a_secure_32_char_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# =============================================
# Security
# =============================================
BCRYPT_ROUNDS=12

# =============================================
# Stripe Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
# =============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=USD

# =============================================
# Business Rules
# =============================================
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=150
FLAT_SHIPPING_RATE=9.99
LOW_STOCK_THRESHOLD=12
MAX_QTY_PER_LINE=10
RESERVATION_TTL_MINUTES=30

# =============================================
# File Uploads
# =============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# =============================================
# Proxy Configuration
# Set to 1 if behind a load balancer
# =============================================
TRUST_PROXY=1

REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=300

# Automatically migrate and seed development data when the API starts.
# Keep false in production; deploy migrations/seeds deliberately.
AUTO_SEED=true


#Retell Voice Agent Secret
RETELL_API_KEY=
RETELL_AGENT_ID=

FRONTEND_URL=http://localhost:5173

LOCATIONIQ_API_KEY=