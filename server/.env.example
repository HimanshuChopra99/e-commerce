# =============================================
# Kick E-Commerce - Environment Configuration
# =============================================

# Environment mode
NODE_ENV=development

# Server port
PORT=4000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174

# =============================================
# Database Configuration
# =============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Kick
# DB_SOCKET=/tmp/mysql.sock  # Use socket instead of host/port
DB_POOL_SIZE=20

# =============================================
# JWT Configuration
# IMPORTANT: Change these in production!
# Must be at least 32 characters each
# =============================================
JWT_ACCESS_SECRET=change_this_to_a_secure_32_char_access_secret
JWT_REFRESH_SECRET=change_this_to_a_secure_32_char_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# =============================================
# Security
# =============================================
BCRYPT_ROUNDS=12

# =============================================
# Stripe Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
# =============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=USD

# =============================================
# Business Rules
# =============================================
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=150
FLAT_SHIPPING_RATE=9.99
LOW_STOCK_THRESHOLD=12
MAX_QTY_PER_LINE=10
RESERVATION_TTL_MINUTES=30

# =============================================
# File Uploads
# =============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# =============================================
# Proxy Configuration
# Set to 1 if behind a load balancer
# =============================================
TRUST_PROXY=1

# Security Warning
# SECURITY: Never commit .env — only .env.example belongs in git.
# Rotate JWT_ACCESS_SECRET and JWT_REFRESH_SECRET before first deployment.

SEED_ADMIN_PASSWORD=change_me_in_production
SEED_CUSTOMER_PASSWORD=change_me_in_production

# Optional: Redis URL for shared rate limiting under horizontal scale
REDIS_URL=redis://localhost:6379
# Customer-specific cache (cart, favourites, orders) — short, invalidated on mutations.
REDIS_CACHE_TTL_SECONDS=120
# Public catalogue (products, categories, filters) — long-lived; explicitly
# invalidated on any product/category/stock/payment change. A short value here
# makes Redis appear "empty" because keys expire every few minutes.
PUBLIC_CACHE_TTL_SECONDS=3600

# Automatically migrate and seed development data when the API starts.
# Keep false in production; deploy migrations/seeds deliberately.
AUTO_SEED=true
