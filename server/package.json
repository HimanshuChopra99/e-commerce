{
  "name": "Kick-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kick — shoe store API (storefront + admin)",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/migrate.js --fresh && node src/database/seed.js",
    "test": "node tests/e2e.test.mjs",
    "test:server": "NODE_ENV=test node index.js",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "fuse.js": "^7.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "rate-limit-redis": "^4.2.0",
    "retell-sdk": "^5.60.0",
    "socket.io": "^4.8.3",
    "stripe": "^16.12.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6"
  }
}
